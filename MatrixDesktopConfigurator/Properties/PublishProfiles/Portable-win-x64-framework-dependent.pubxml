<Project>
  <PropertyGroup>
    <!--
      Smaller portable folder output for Windows x64 (framework-dependent).
      Publishes beside MatrixDesktop.exe in <solutionRoot>\publish\win-x64-fd\.
    -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Native pre-compilation for faster cold start; requires the RID above. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <InvariantGlobalization>true</InvariantGlobalization>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      SHARED OUTPUT DIRECTORY — this is deliberate.

      MatrixDesktop/Properties/PublishProfiles/
      Portable-win-x64-framework-dependent.pubxml resolves to this same
      publish\win-x64-fd\ folder so both executables land side by side. See that
      file for the full rationale. Two rules follow from it:

      - DeleteExistingFiles must stay unset here. Setting it would wipe
        MatrixDesktop.exe and the web\ assets whenever the configurator is
        published second.

      - Publish both projects together and at the same <Version>. Publish is
        additive and last-write-wins per file, so publishing only one after a
        version bump silently leaves mismatched shared assemblies in the folder.
        publish-portable-win-x64-fd.cmd does it correctly.
    -->
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\win-x64-fd\</PublishDir>
  </PropertyGroup>
</Project>
