<!--
  Standalone argument configurator for MatrixDesktop.
  Uses WinForms only as the native shell and WebView2 for the actual UI.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allow building on non-Windows hosts (CI, WSL). No-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MatrixDesktopConfigurator</AssemblyName>
    <RootNamespace>MatrixDesktopConfigurator</RootNamespace>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <ApplicationIcon>..\MatrixDesktop\Matrix.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!--
      Publish payload hygiene. See the matching block in
      MatrixDesktop/MatrixDesktop.csproj for the full rationale: the workflows
      and tests\run-gate.ps1 publish with raw -p: properties and never load a
      .pubxml, so a DebugType set only in the profile applied to nothing.
      Scoped to Release so Debug keeps full symbols.
    -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared sources used by both MatrixDesktop and MatrixDesktopConfigurator. -->
    <Compile Include="..\Shared\Logger.cs" Link="Shared\Logger.cs" />
    <Compile Include="..\Shared\FlagNormalization.cs" Link="Shared\FlagNormalization.cs" />
    <Compile Include="..\Shared\CrashDumpWriter.cs" Link="Shared\CrashDumpWriter.cs" />
    <Compile Include="..\Shared\AppWindowIcon.cs" Link="Shared\AppWindowIcon.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configurator embeds the same argument guide so its "?" button works
         without needing the sibling MatrixDesktop.exe to be present. -->
    <EmbeddedResource Include="..\MatrixDesktop_Argument_Guide.txt" LogicalName="MatrixDesktop.ArgumentGuide.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embedded copy only. Shared/AppWindowIcon.cs prefers the embedded resource,
      and both executables publish into the same folder, so the loose on-disk
      Matrix.ico was being written twice into one 361 KB slot for no reader.
    -->
    <EmbeddedResource Include="..\MatrixDesktop\Matrix.ico" LogicalName="Matrix.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="configurator\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="configurator\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="_MatrixDesktopConfigurator_RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>

