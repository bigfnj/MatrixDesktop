<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\MatrixDesktop\HostLaunchPlan.cs" Link="Production\HostLaunchPlan.cs" />
    <Compile Include="..\..\MatrixDesktop\ScreensaverWindowPolicy.cs" Link="Production\ScreensaverWindowPolicy.cs" />
    <Compile Include="..\..\MatrixDesktop\ForegroundWindow.cs" Link="Production\ForegroundWindow.cs" />
    <Compile Include="..\..\MatrixDesktop\AutostartService.cs" Link="Production\AutostartService.cs" />
    <Compile Include="..\..\MatrixDesktop\HostControlLifetime.cs" Link="Production\HostControlLifetime.cs" />
    <Compile Include="..\..\MatrixDesktop\DesktopHostDiscovery.cs" Link="Production\DesktopHostDiscovery.cs" />
    <Compile Include="..\..\Shared\GdiGlyphAtlas.cs" Link="Production\GdiGlyphAtlas.cs" />
    <Compile Include="..\..\Shared\WallpaperBackground.cs" Link="Production\WallpaperBackground.cs" />
    <Compile Include="..\..\Shared\CrashDumpWriter.cs" Link="Production\CrashDumpWriter.cs" />
    <Compile Include="..\..\Shared\Logger.cs" Link="Production\Logger.cs" />
    <Content Include="..\..\MatrixDesktop\web\assets\zmatrix\matrix-code.ttf" Link="matrix-code.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\MatrixDesktop\web\assets\zmatrix\matrix-code.LICENSE" Link="matrix-code.LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
