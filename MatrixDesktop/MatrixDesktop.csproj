<!--
  NOTE:
  - NETSDK1137 warns that Microsoft.NET.Sdk.WindowsDesktop is unnecessary for .NET 5+.
    Using Microsoft.NET.Sdk + <UseWindowsForms>true</UseWindowsForms> is the modern approach.
  - Recent versions of Microsoft.Web.WebView2 bring in the WPF control assembly as a reference
    (Microsoft.Web.WebView2.Wpf.dll) even for WinForms-only apps, which can trigger an MSB3277
    WindowsBase 4.0/5.0 conflict warning. We explicitly remove the WPF assembly reference.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allow building on non-Windows hosts (CI, WSL). No-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MatrixDesktop</AssemblyName>
    <RootNamespace>MatrixDesktop</RootNamespace>
    <!-- Local-build default only. release.yml overrides all three from the pushed tag, which
         is why the shipped 1.0.3 and 1.0.4 binaries stamped correctly while this said 1.0.2.
         Keep it current anyway: it is what a developer's own build reports, and
         tests\run-gate.ps1 holds the argument guide's header to this value. -->
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <!-- Icon for the compiled EXE -->
    <ApplicationIcon>Matrix.ico</ApplicationIcon>

    <!--
      Safety net: if an MSBuild/SDK layer still emits MSB3277 (e.g., via transitive targets),
      we suppress it so "treat warnings as errors" builds remain unblocked.
    -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!--
      Publish payload hygiene.

      These live in the project rather than only in the .pubxml because every
      automated publish path bypasses the profiles and passes raw properties
      instead: both GitHub workflows and tests\run-gate.ps1 invoke
      `dotnet publish -c Release -r win-x64 -p:PublishDir=...`. The DebugType
      set inside Portable-win-x64-framework-dependent.pubxml therefore never
      applied to a single automated build, and the payload shipped 684,631
      bytes of .pdb plus WebView2 IntelliSense .xml.

      AllowedReferenceRelatedFileExtensions=none drops the .pdb/.xml that would
      otherwise ride along with each referenced assembly (that is where the
      WebView2 doc XML comes from). DebugType/DebugSymbols drop this project's
      own symbols.

      Scoped to Release so a Debug build keeps full symbols for local
      debugging. Tradeoff: a Release crash dump written by
      Shared/CrashDumpWriter.cs will have no line numbers.
    -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2: embeds Edge (Chromium) for rendering the HTML/JS app -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared sources used by both MatrixDesktop and MatrixDesktopConfigurator. -->
    <Compile Include="..\Shared\Logger.cs" Link="Shared\Logger.cs" />
    <Compile Include="..\Shared\FlagNormalization.cs" Link="Shared\FlagNormalization.cs" />
    <Compile Include="..\Shared\CrashDumpWriter.cs" Link="Shared\CrashDumpWriter.cs" />
    <Compile Include="..\Shared\AppWindowIcon.cs" Link="Shared\AppWindowIcon.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argument guide is embedded so /-help-full works without a sibling file. -->
    <EmbeddedResource Include="..\MatrixDesktop_Argument_Guide.txt" LogicalName="MatrixDesktop.ArgumentGuide.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Matrix.ico ships exactly once, as an embedded resource (57,485 bytes; it was
      361,102 until every entry was uncompressed BMP, including a 256x256 costing
      270 KB on its own. The 128 and 256 entries are now PNG-compressed, which the
      ICO format has allowed since Vista, and 16 through 64 stay BMP because those
      are the sizes the taskbar, title bar and alt-tab actually pull. Verified
      pixel-identical to the original at every size, RMSE 0, and verified loadable
      through System.Drawing.Icon at every size, which is what AppWindowIcon uses.
      Measured, not estimated: the icon appears SIX times in the publish output,
      twice in each .dll (the managed EmbeddedResource plus the Win32 icon resource
      the SDK stamps from ApplicationIcon) and once in each apphost .exe. So the
      saving lands six times, and the payload went 6,960,895 -> 5,137,381 bytes,
      down 1,823,514 or 26.2%.

      Note the release ZIP barely moves, because Deflate already squeezed the old
      uncompressed BMP down to roughly its PNG size. The win is installed footprint
      and PE size, not download size; do not expect the release asset to shrink.

      Still redundant: the Win32 icon resource inside each .dll is dead weight,
      since nothing displays a library's icon and only the apphost .exe matters to
      Explorer. ApplicationIcon drives both and the SDK offers no switch to split
      them, so two of the six copies stay. That is 115 KB, and left in BACKLOG.)
      Shared/AppWindowIcon.cs reads the embedded copy first and only falls back
      to an on-disk Matrix.ico beside the EXE if that lookup returns null, so
      the loose <Content> copy that used to live here was dead weight in every
      payload. <ApplicationIcon> above still stamps the icon into the PE header,
      which is what Explorer reads and what the third fallback
      (Icon.ExtractAssociatedIcon) recovers.
    -->
    <EmbeddedResource Include="Matrix.ico" LogicalName="Matrix.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the web assets are treated as Content (not None) so they can be copied to output. -->
    <None Remove="web\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Copy the web assets into BOTH build output and publish output so the EXE can load them at runtime.

      The upstream repo includes extra folders and sources that are not required for the
      desktop wrapper. Excluding them keeps publish output smaller and build/publish faster.

      Notes:
        - We keep the JS modules, shaders, fonts, images, etc.
        - We exclude docs/dev helpers (md/txt), large screenshots, and non-runtime source folders.
    -->
    <Content Include="web\**\*"
             Exclude="web\playdate\**\*;web\msdfgen\**\*;web\svg sources\**\*;web\screenshot.png;web\lib\regl.js;web\**\*.md;web\**\*.txt;web\.gitmodules;web\.gitignore;web\.gitattributes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Workaround for MSB3277 WindowsBase 4.0/5.0 conflicts caused by WebView2's WPF control reference.
    This project is WinForms-only, so the WPF control assembly is not needed.
  -->
  <Target Name="_MatrixDesktop_RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>

