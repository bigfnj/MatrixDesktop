<Project>
  <PropertyGroup>
    <!--
      Smaller portable folder output for Windows x64 (framework-dependent).
      Requires .NET Desktop Runtime on the target machine.

      Produces: <solutionRoot>\publish\win-x64-fd\
    -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Single-folder (not single-file) -->
    <PublishSingleFile>false</PublishSingleFile>

    <PublishTrimmed>false</PublishTrimmed>

    <!--
      Ahead-of-time compile the managed code to native for faster cold start.
      Needs the RuntimeIdentifier above; a RID-less publish would fail
      NETSDK1094. Costs disk (the R2R image carries both IL and native code)
      and buys startup latency, which matters for a wallpaper-style app that
      is launched and closed repeatedly.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Smaller output: skip culture/ICU data (safe for this app). -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      SHARED OUTPUT DIRECTORY — this is deliberate.

      MatrixDesktopConfigurator/Properties/PublishProfiles/
      Portable-win-x64-framework-dependent.pubxml resolves to this same
      publish\win-x64-fd\ folder. The two executables have to land side by side:
      the configurator's "Test Argument" button launches MatrixDesktop.exe from
      its own directory, and README documents a single portable folder holding
      both. publish-portable-win-x64-fd.cmd publishes both projects in sequence
      into this one folder.

      Consequences, both intentional:

      - DeleteExistingFiles is NOT set, and must not be. Either profile setting
        it would wipe the other executable's output on every publish, because
        whichever project publishes second would clear the folder first.

      - Because nothing deletes, publish is additive and last-write-wins per
        file. The two projects share MatrixDesktop.deps.json's transitive set
        (WebView2, runtimes\win-x64\native), so ALWAYS publish both projects
        together and at the SAME <Version>. Publishing only one after a version
        bump leaves a folder with two executables built against mismatched
        shared assemblies, and nothing here detects that. Use
        publish-portable-win-x64-fd.cmd, which wipes the folder first and then
        publishes both.
    -->
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\win-x64-fd\</PublishDir>
  </PropertyGroup>
</Project>
